# Copy to .env.local for local runs. On Vercel, add the same names under Settings > Environment Variables.

# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET key (sb_secret_... or the legacy service_role key). Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend > API Keys
RESEND_API_KEY=
# Optional. onboarding@resend.dev only delivers to your own Resend account email until you verify a domain.
EMAIL_FROM=BuildMatch <onboarding@resend.dev>

# Full address of this site, no trailing slash. Used for the guide link in emails.
SITE_URL=http://localhost:3000
